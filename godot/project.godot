; Tierras Vivas — proyecto Godot 4 (OpenXR, Meta Quest 3/3S y PC)

config_version=5

[application]

config/name="Tierras Vivas"
config/description="Prototipo de VRMMORPG de mundo vivo inspirado en Log Horizon y Overgeared."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

general/text_to_speech=true

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=72

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/foveation_level=0
openxr/foveation_dynamic=false
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
